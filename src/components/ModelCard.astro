---
import type { Model } from "../data/types";
import { getFounder, initialsOf } from "../data/founders";

interface Props {
  model: Model;
}

const { model } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a href={`${base}models/${model.slug}/`} class="card card-hover group flex flex-col p-6">
  <div class="flex items-center justify-between">
    <span class="font-display text-4xl font-semibold text-gold-500/40 transition group-hover:text-gold-500/70">{model.index}</span>
    <span class="flex -space-x-2">
      {model.epitomeFounders?.map((slug) => {
        const f = getFounder(slug);
        return (
          <span
            class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-ink-850 bg-ink-700 text-[10px] font-bold text-paper-100"
            title={f.name}
          >
            {initialsOf(f.name)}
          </span>
        );
      })}
    </span>
  </div>
  <h3 class="mt-4 font-display text-xl font-semibold leading-tight">{model.title}</h3>
  <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-gold-400">{model.tagline}</p>
  <p class="mt-3 text-sm leading-relaxed text-paper-300 line-clamp-3">{model.philosophy}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {model.keyFrameworks.map((k) => (
      <span class="rounded-full border border-ink-600 px-2.5 py-0.5 text-[11px] text-paper-400">{k}</span>
    ))}
  </div>
  <span class="mt-5 text-sm font-medium text-gold-400 transition group-hover:translate-x-0.5">
    Explore model →
  </span>
</a>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
