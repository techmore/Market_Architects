---
import Layout from "../../layouts/Layout.astro";
import LectureCard from "../../components/LectureCard.astro";
import FounderCard from "../../components/FounderCard.astro";
import BookCard from "../../components/BookCard.astro";
import { models, getModel } from "../../data/models";
import { founders } from "../../data/founders";
import { lecturesByModel } from "../../data/lectures";
import { booksByModel } from "../../data/books";

export async function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model } = Astro.props;
const base = import.meta.env.BASE_URL;
const modelFounders = founders.filter((f) => f.models.includes(model.slug));
const modelLectures = lecturesByModel(model.slug);
const modelBooks = booksByModel(model.slug);
const related = models.filter((m) => m.slug !== model.slug);
---

<Layout title={model.title} description={model.philosophy}>
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-14 md:py-16">
      <a href={`${base}models/`} class="text-xs font-medium uppercase tracking-wider text-paper-500 hover:text-gold-300">
        ← All models
      </a>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Model {model.index}</p>
          <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight md:text-5xl">{model.title}</h1>
          <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-gold-400">{model.tagline}</p>
        </div>
        <p class="font-display text-7xl font-semibold text-gold-500/20 md:text-8xl">{model.index}</p>
      </div>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-paper-200">{model.philosophy}</p>
    </div>
  </div>

  <div class="container-site py-14">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="eyebrow">Core principles</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {model.core.map((c) => (
            <li class="card flex items-start gap-3 p-4">
              <span class="mt-0.5 text-gold-400">▸</span>
              <span class="text-sm text-paper-200">{c}</span>
            </li>
          ))}
        </ul>

        <p class="mt-10 eyebrow">Curated lectures</p>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          {modelLectures.map((l) => <LectureCard lecture={l} />)}
        </div>

        {modelBooks.length > 0 && (
          <>
            <p class="mt-10 eyebrow">Reading list</p>
            <div class="mt-4 grid gap-5">
              {modelBooks.map((b) => <BookCard book={b} />)}
            </div>
          </>
        )}
      </div>

      <aside class="space-y-6">
        <div class="card p-5">
          <p class="eyebrow">Epitome founders</p>
          <div class="mt-4 space-y-3">
            {modelFounders.map((f) => <FounderCard founder={f} />)}
          </div>
        </div>

        <div class="card p-5">
          <p class="eyebrow">Key frameworks</p>
          <ul class="mt-4 space-y-3">
            {model.keyFrameworks.map((k) => (
              <li class="flex items-start gap-3 text-sm text-paper-200">
                <span class="mt-0.5 text-gold-400">✦</span>
                {k}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>

  <div class="border-t border-ink-800 bg-ink-900">
    <div class="container-site py-12">
      <p class="eyebrow">Related models</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.slice(0, 3).map((m) => (
          <a href={`${base}models/${m.slug}/`} class="card card-hover flex items-center justify-between p-5">
            <div>
              <p class="font-display text-lg font-semibold">{m.title}</p>
              <p class="text-xs text-paper-400">{m.tagline}</p>
            </div>
            <span class="text-gold-400">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
