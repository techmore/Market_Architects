---
import Layout from "../../layouts/Layout.astro";
import FounderCard from "../../components/FounderCard.astro";
import { founders } from "../../data/founders";
import { lectures } from "../../data/lectures";

const builders = founders.filter((f) => f.kind === "builder");
const thinkers = founders.filter((f) => f.kind === "thinker");
---

<Layout title="Leaders & Thinkers" description="An exhaustive directory of legendary founders and business thought leaders — and the mental models they embody.">
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-14 md:py-16">
      <p class="eyebrow">Leader directory</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold tracking-tight md:text-5xl">
        The people behind the models
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-paper-300">
        {founders.length} leaders — from founders who built the companies to thinkers who built the
        frameworks. Every leader is tagged by the mental models they embody, with curated lectures,
        annotated transcripts, and cross-references.
      </p>
    </div>
  </div>

  <div class="container-site py-14">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="text-sm text-paper-400">
        {founders.length} leaders · {lectures.length} lectures
      </p>
      <div class="flex gap-2" role="group" aria-label="Filter by kind">
        <button data-kind="all" class="kind-chip rounded-full border border-gold-500 bg-gold-500 px-4 py-1.5 text-sm font-semibold text-ink-950">All</button>
        <button data-kind="builder" class="kind-chip rounded-full border border-ink-600 px-4 py-1.5 text-sm font-medium text-paper-200 transition hover:border-gold-500/60 hover:text-gold-300">
          Builders · {builders.length}
        </button>
        <button data-kind="thinker" class="kind-chip rounded-full border border-ink-600 px-4 py-1.5 text-sm font-medium text-paper-200 transition hover:border-gold-500/60 hover:text-gold-300">
          Thinkers · {thinkers.length}
        </button>
      </div>
    </div>

    <div id="founder-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {founders.map((f) => (
        <div class="founder-item" data-kind={f.kind}>
          <FounderCard founder={f} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".kind-chip"));
  let active = "all";

  function apply() {
    document.querySelectorAll<HTMLElement>(".founder-item").forEach((el) => {
      el.style.display = active === "all" || el.dataset.kind === active ? "" : "none";
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      active = chip.dataset.kind ?? "all";
      chips.forEach((c) => {
        if (c === chip) {
          c.classList.remove("border-ink-600", "text-paper-200");
          c.classList.add("border-gold-500", "bg-gold-500", "text-ink-950");
        } else {
          c.classList.add("border-ink-600", "text-paper-200");
          c.classList.remove("border-gold-500", "bg-gold-500", "text-ink-950");
        }
      });
      apply();
    });
  });
</script>
