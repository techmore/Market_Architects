---
import Layout from "../../layouts/Layout.astro";
import FounderCard from "../../components/FounderCard.astro";
import { founders } from "../../data/founders";
import { lectures } from "../../data/lectures";

const builders = founders.filter((f) => f.kind === "builder");
const thinkers = founders.filter((f) => f.kind === "thinker");
---

<Layout title="Leaders & Thinkers" description="An exhaustive directory of legendary founders and business thought leaders — and the mental models they embody.">
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-14 md:py-16">
      <p class="eyebrow">Leader directory</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold tracking-tight md:text-5xl">
        The people behind the models
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-paper-300">
        {founders.length} leaders — from founders who built the companies to thinkers who built the
        frameworks. Every leader is tagged by the mental models they embody, with curated lectures,
        annotated transcripts, and cross-references.
      </p>
    </div>
  </div>

  <div class="container-site py-14">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p id="founder-count" class="text-sm text-paper-400" role="status" aria-live="polite">
        {founders.length} leaders · {lectures.length} lectures
      </p>
      <div class="flex gap-2" role="group" aria-label="Filter by kind">
        <button type="button" data-kind="all" class="chip" aria-pressed="true">All <span class="chip-count">{founders.length}</span></button>
        <button type="button" data-kind="builder" class="chip" aria-pressed="false">Builders <span class="chip-count">{builders.length}</span></button>
        <button type="button" data-kind="thinker" class="chip" aria-pressed="false">Thinkers <span class="chip-count">{thinkers.length}</span></button>
      </div>
    </div>

    <div id="founder-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {founders.map((f) => (
        <div class="founder-item" data-kind={f.kind}>
          <FounderCard founder={f} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip[data-kind]"));
  const items = Array.from(document.querySelectorAll<HTMLElement>(".founder-item"));
  const count = document.getElementById("founder-count");
  const lectureTotal = count?.textContent?.match(/(\d+) lectures/)?.[1] ?? "";
  let active = "all";

  function apply() {
    let visible = 0;
    for (const el of items) {
      const show = active === "all" || el.dataset.kind === active;
      el.hidden = !show;
      if (show) visible++;
    }
    if (count) {
      const label = active === "all" ? "leaders" : active === "builder" ? "builders" : "thinkers";
      count.textContent = `${visible} ${label} · ${lectureTotal} lectures`;
    }
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      active = chip.dataset.kind ?? "all";
      for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));
      apply();
    });
  }
</script>
