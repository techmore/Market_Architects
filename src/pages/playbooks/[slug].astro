---
import Layout from "../../layouts/Layout.astro";
import ApplyThisModel from "../../components/ApplyThisModel.astro";
import { playbooks, getPlaybook } from "../../data/playbooks";
import { getModel } from "../../data/models";
import { getLecture } from "../../data/lectures";
import { getBook } from "../../data/books";
import { getFounder } from "../../data/founders";

export async function getStaticPaths() {
  return playbooks.map((p) => ({ params: { slug: p.slug }, props: { playbook: p } }));
}

const { playbook } = Astro.props;
const base = import.meta.env.BASE_URL;
const modelObjs = playbook.models.map((slug) => getModel(slug));
---

<Layout title={playbook.title} description={playbook.problem}>
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-14 md:py-16">
      <a href={`${base}playbooks/`} class="text-xs font-medium uppercase tracking-wider text-paper-500 hover:text-gold-300">
        ← All playbooks
      </a>
      <p class="eyebrow mt-6">Playbook</p>
      <h1 class="mt-2 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight md:text-5xl">
        {playbook.title}
      </h1>
      <div class="mt-4 flex flex-wrap gap-2">
        {modelObjs.map((m) => (
          <a href={`${base}models/${m.slug}/`} class="rounded-full border border-gold-500/50 px-3 py-1 text-xs font-medium text-gold-300 hover:bg-gold-500/10">
            {m.title}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="container-site py-12">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="rounded-xl border-l-4 border-clay-500 bg-ink-850 p-6">
          <p class="eyebrow text-clay-400">The problem</p>
          <p class="mt-3 text-lg leading-relaxed text-paper-100">{playbook.problem}</p>
        </div>

        <p class="mt-8 eyebrow">The playbook</p>
        <p class="mt-2 text-base leading-relaxed text-paper-200">{playbook.summary}</p>

        <ol class="mt-8 space-y-6">
          {playbook.steps.map((step, i) => {
            const lecture = step.lecture ? getLecture(step.lecture) : null;
            const founder = lecture ? getFounder(lecture.founder) : null;
            const book = step.book ? getBook(step.book) : null;
            return (
              <li class="card p-6">
                <div class="flex items-start gap-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold-500 font-display text-sm font-bold text-ink-950">
                    {i + 1}
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-display text-lg font-semibold">{step.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-paper-300">{step.body}</p>
                    {lecture && founder && (
                      <a href={`${base}lectures/${lecture.slug}/`} class="mt-3 inline-flex items-center gap-2 rounded-lg border border-ink-600 px-3 py-1.5 text-xs font-medium text-paper-100 transition hover:border-gold-500/60 hover:text-gold-300">
                        <span>▶</span>
                        {founder.name}: {lecture.title}
                      </a>
                    )}
                    {book && (
                      <a href={`${base}books/${book.slug}/`} class="mt-3 inline-flex items-center gap-2 rounded-lg border border-ink-600 px-3 py-1.5 text-xs font-medium text-paper-100 transition hover:border-gold-500/60 hover:text-gold-300">
                        <span>📕</span>
                        {book.title}
                      </a>
                    )}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </div>

      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="rounded-xl border border-ink-600 bg-ink-850 p-5">
          <p class="eyebrow">Models used</p>
          <div class="mt-4 space-y-3">
            {modelObjs.map((m) => (
              <a href={`${base}models/${m.slug}/`} class="flex items-start gap-3 rounded-lg border border-ink-700 p-3 text-sm text-paper-200 transition hover:border-gold-500/60">
                <span class="font-display text-gold-400">{m.index}</span>
                <span>{m.title}</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
