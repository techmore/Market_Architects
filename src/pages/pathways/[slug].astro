---
import Layout from "../../layouts/Layout.astro";
import { pathways } from "../../data/pathways";
import { getLecture } from "../../data/lectures";
import { getBook } from "../../data/books";
import { getPlaybook } from "../../data/playbooks";
import { getModel } from "../../data/models";

export async function getStaticPaths() {
  return pathways.map((p) => ({ params: { slug: p.slug }, props: { pathway: p } }));
}

const { pathway } = Astro.props;
const base = import.meta.env.BASE_URL;
const siblingEntry = pathway.entry === "ideas" ? "founders" : "ideas";
const related = pathways.filter((p) => p.entry === pathway.entry && p.slug !== pathway.slug);
const otherEntry = pathways.find((p) => p.entry === siblingEntry);
---

<Layout title={pathway.title} description={pathway.intro}>
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-14 md:py-16">
      <a href={`${base}pathways/`} class="text-xs font-medium uppercase tracking-wider text-paper-500 hover:text-gold-300">
        ← All pathways
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-gold-500/50 px-3 py-1 text-xs font-medium text-gold-300">
          {pathway.entry === "ideas" ? "Route 01 · New ideas" : "Route 02 · Great founders"}
        </span>
        <span class="text-xs text-paper-500">{pathway.estimated}</span>
      </div>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        {pathway.title}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-paper-200">{pathway.intro}</p>

      <div class="mt-8 flex flex-wrap gap-2">
        {pathway.steps.map((_, i) => (
          <span class:list={["h-1.5 w-8 rounded-full", i === 0 ? "bg-gold-500" : "bg-ink-700"]}></span>
        ))}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <div id="progress-wrap" class="h-2 w-40 overflow-hidden rounded-full bg-ink-800" data-slug={pathway.slug} data-total={pathway.steps.length}>
          <div id="progress-bar" class="h-full w-0 bg-gold-500 transition-all duration-300"></div>
        </div>
        <span id="progress-label" class="text-xs text-paper-400">0 of {pathway.steps.length} stops complete</span>
      </div>
    </div>
  </div>

  <div class="container-site py-14">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="eyebrow">The route</p>
        <div class="relative mt-6 space-y-6 before:absolute before:bottom-4 before:left-[22px] before:top-4 before:w-px before:bg-ink-700">
          {pathway.steps.map((step, i) => {
            const lecture = step.lecture ? getLecture(step.lecture) : null;
            const book = step.book ? getBook(step.book) : null;
            const playbook = step.playbook ? getPlaybook(step.playbook) : null;
            const model = step.model ? getModel(step.model) : null;
            return (
              <div class="relative flex gap-5">
                <span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gold-500/50 bg-ink-900 font-display text-sm font-bold text-gold-400">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="card min-w-0 flex-1 p-6">
                  <div class="flex items-start justify-between gap-3">
                    <p class="eyebrow">{step.station}</p>
                    <button
                      class="mark-done shrink-0 rounded-full border border-ink-600 px-3 py-1 text-[11px] font-semibold text-paper-300 transition hover:border-gold-500/60 hover:text-gold-300"
                      data-index={i}
                      aria-pressed="false"
                    >
                      Mark complete
                    </button>
                  </div>
                  <h2 class="mt-2 font-display text-2xl font-semibold leading-tight">{step.title}</h2>
                  <p class="mt-3 text-sm leading-relaxed text-paper-300">{step.narrative}</p>

                  <div class="mt-5 flex flex-wrap gap-2">
                    {lecture && (
                      <a
                        href={`${base}lectures/${lecture.slug}/`}
                        class="inline-flex items-center gap-2 rounded-lg border border-ink-600 bg-ink-900 px-3 py-2 text-sm font-medium text-paper-100 transition hover:border-gold-500/60 hover:text-gold-300"
                      >
                        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-gold-500 text-[9px] font-bold text-ink-950">▶</span>
                        {lecture.title}
                      </a>
                    )}
                    {book && (
                      <a
                        href={`${base}books/${book.slug}/`}
                        class="inline-flex items-center gap-2 rounded-lg border border-ink-600 bg-ink-900 px-3 py-2 text-sm font-medium text-paper-100 transition hover:border-gold-500/60 hover:text-gold-300"
                      >
                        <span class="text-gold-400">📕</span>
                        {book.title}
                      </a>
                    )}
                    {playbook && (
                      <a
                        href={`${base}playbooks/${playbook.slug}/`}
                        class="inline-flex items-center gap-2 rounded-lg border border-ink-600 bg-ink-900 px-3 py-2 text-sm font-medium text-paper-100 transition hover:border-gold-500/60 hover:text-gold-300"
                      >
                        <span class="text-gold-400">⚙</span>
                        Playbook: {playbook.title}
                      </a>
                    )}
                    {model && (
                      <a
                        href={`${base}models/${model.slug}/`}
                        class="inline-flex items-center rounded-full border border-gold-500/40 px-3 py-1.5 text-xs font-medium text-gold-300 transition hover:bg-gold-500/10"
                      >
                        Model {model.index} · {model.title}
                      </a>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <div class="mt-10 rounded-xl border-l-4 border-green-500 bg-ink-850 p-6">
          <p class="eyebrow">When you finish</p>
          <p class="mt-3 text-base leading-relaxed text-paper-200">{pathway.outcome}</p>
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">
        <div class="card p-5">
          <p class="eyebrow">Try the other door</p>
          {otherEntry && (
            <a href={`${base}pathways/${otherEntry.slug}/`} class="mt-4 block rounded-lg border border-ink-700 bg-ink-900 p-4 transition hover:border-gold-500/60">
              <p class="text-sm font-semibold text-paper-100">{otherEntry.title}</p>
              <p class="mt-1 text-xs text-paper-400">
                {otherEntry.entry === "ideas" ? "Looking for new ideas" : "Hear from great founders"}
              </p>
            </a>
          )}
        </div>

        {pathway.slug === "owners-compass" && (
          <div class="card p-5 border-gold-500/40">
            <p class="eyebrow">Build your philosophy</p>
            <a href={`${base}archetypes/`} class="mt-4 block rounded-lg border border-ink-700 bg-ink-900 p-4 transition hover:border-gold-500/60">
              <p class="text-sm font-semibold text-paper-100">The six archetypes →</p>
              <p class="mt-1 text-xs text-paper-400">
                Adopt a lived operating philosophy — Steward, Operator, Monopolist, Missionary, Craftsman, Allocator — instead of reinventing one.
              </p>
            </a>
          </div>
        )}

        <div class="card p-5">
          <p class="eyebrow">Related pathways</p>
          <div class="mt-4 space-y-3">
            {related.map((p) => (
              <a href={`${base}pathways/${p.slug}/`} class="block rounded-lg border border-ink-700 bg-ink-900 p-4 transition hover:border-gold-500/60">
                <p class="text-sm font-semibold text-paper-100">{p.title}</p>
                <p class="mt-1 text-xs text-paper-400">{p.steps.length} stops · {p.estimated}</p>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const wrap = document.getElementById("progress-wrap");
  const slug = wrap?.dataset.slug ?? "";
  const PATH_KEY = "ma-progress-" + slug;
  const TOTAL = Number(wrap?.dataset.total ?? 0);
  const bar = document.getElementById("progress-bar");
  const label = document.getElementById("progress-label");

  function readProgress(): number[] {
    try {
      const raw = localStorage.getItem(PATH_KEY);
      const arr = raw ? JSON.parse(raw) : [];
      return Array.isArray(arr) ? arr : [];
    } catch (e) {
      return [];
    }
  }

  function render() {
    const done = readProgress().filter((n) => n !== null && n !== undefined);
    const pct = TOTAL ? Math.round((done.length / TOTAL) * 100) : 0;
    if (bar) bar.style.width = pct + "%";
    if (label) label.textContent = `${done.length} of ${TOTAL} stops complete`;
    document.querySelectorAll<HTMLButtonElement>(".mark-done").forEach((btn) => {
      const idx = Number(btn.dataset.index);
      const isDone = done.includes(idx);
      btn.setAttribute("aria-pressed", String(isDone));
      btn.textContent = isDone ? "✓ Complete" : "Mark complete";
      btn.classList.toggle("border-gold-500/70", isDone);
      btn.classList.toggle("text-gold-300", isDone);
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".mark-done").forEach((btn) => {
    btn.addEventListener("click", () => {
      const idx = Number(btn.dataset.index);
      const current = readProgress();
      const next = current.includes(idx) ? current.filter((n) => n !== idx) : [...current, idx];
      try {
        localStorage.setItem(PATH_KEY, JSON.stringify(next));
      } catch (e) {
        /* private mode — ignore */
      }
      render();
    });
  });

  render();
</script>
