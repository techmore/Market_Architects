---
import Layout from "../../layouts/Layout.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import AnnotatedTimestamps from "../../components/AnnotatedTimestamps.astro";
import ApplyThisModel from "../../components/ApplyThisModel.astro";
import CrossReferences from "../../components/CrossReferences.astro";
import LectureCard from "../../components/LectureCard.astro";
import { lectures, getLecture } from "../../data/lectures";
import { getModel } from "../../data/models";
import { getFounder, initialsOf } from "../../data/founders";

export async function getStaticPaths() {
  return lectures.map((l) => ({ params: { slug: l.slug }, props: { lecture: l } }));
}

const { lecture } = Astro.props;
const base = import.meta.env.BASE_URL;
const founder = getFounder(lecture.founder);
const model = getModel(lecture.model);
const related = lectures
  .filter((l) => l.model === lecture.model && l.slug !== lecture.slug)
  .concat(lectures.filter((l) => l.founder === lecture.founder && l.slug !== lecture.slug))
  .filter((l, i, arr) => arr.findIndex((x) => x.slug === l.slug) === i)
  .slice(0, 3);
const ogImage = lecture.youtubeId
  ? `https://img.youtube.com/vi/${lecture.youtubeId}/maxresdefault.jpg`
  : undefined;
---

<Layout title={lecture.title} description={lecture.summary} image={ogImage}>
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-12 md:py-14">
      <a href={`${base}lectures/`} class="text-xs font-medium uppercase tracking-wider text-paper-500 hover:text-gold-300">
        ← All lectures
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
        <a href={`${base}founders/${founder.slug}/`} class="flex items-center gap-2 font-medium text-paper-100 hover:text-gold-300">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink-700 text-[10px] font-bold text-gold-300">
            {initialsOf(founder.name)}
          </span>
          {founder.name}
        </a>
        <span class="text-paper-500">·</span>
        <a href={`${base}models/${model.slug}/`} class="rounded-full border border-gold-500/50 px-2.5 py-0.5 text-xs font-medium text-gold-300 hover:bg-gold-500/10">
          {model.title}
        </a>
        <span class="text-paper-500">·</span>
        <span class="text-paper-400">{lecture.length} · {lecture.source}</span>
      </div>
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
        {lecture.title}
      </h1>
    </div>
  </div>

  <div class="container-site py-10">
    <div class="grid gap-8 lg:grid-cols-[1fr_380px]">
      <div class="min-w-0 space-y-8">
        <VideoEmbed lecture={lecture} />

        <div class="card p-6">
          <p class="eyebrow">The core argument</p>
          <p class="mt-3 font-display text-xl leading-relaxed text-paper-100 md:text-2xl">
            {lecture.coreArgument}
          </p>
        </div>

        <p class="max-w-3xl text-base leading-relaxed text-paper-200">{lecture.summary}</p>

        <AnnotatedTimestamps lecture={lecture} />

        {lecture.crossReferences.length > 0 && <CrossReferences lecture={lecture} />}

        <div class="card p-6">
          <p class="eyebrow">Keywords</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {lecture.keywords.map((k) => (
              <span class="rounded-full border border-ink-600 px-2.5 py-0.5 text-xs text-paper-300">{k}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="lg:sticky lg:top-20 lg:self-start">
        <ApplyThisModel lecture={lecture} />
      </aside>
    </div>
  </div>

  {related.length > 0 && (
    <div class="border-t border-ink-800 bg-ink-900">
      <div class="container-site py-12">
        <p class="eyebrow">Keep exploring</p>
        <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((l) => <LectureCard lecture={l} />)}
        </div>
      </div>
    </div>
  )}
</Layout>
