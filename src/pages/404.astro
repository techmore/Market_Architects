---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Page not found">
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-8xl font-semibold text-gold-500/40">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold">This blueprint never got built.</h1>
    <p class="mt-3 max-w-md text-paper-400">
      The page you're looking for doesn't exist — or hasn't been architected yet.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={base} class="btn-primary">Back to home</a>
      <a href={`${base}search/`} class="btn-ghost">Search the library</a>
    </div>
    <nav aria-label="Popular sections" class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
      <a href={`${base}skill-tree/`} class="text-gold-400 hover:text-gold-300">The course</a>
      <a href={`${base}models/`} class="text-gold-400 hover:text-gold-300">Mental models</a>
      <a href={`${base}founders/`} class="text-gold-400 hover:text-gold-300">Leaders</a>
      <a href={`${base}lectures/`} class="text-gold-400 hover:text-gold-300">Lectures</a>
      <a href={`${base}books/`} class="text-gold-400 hover:text-gold-300">Books</a>
    </nav>
  </div>
</Layout>
