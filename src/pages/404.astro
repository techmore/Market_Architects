---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Page not found">
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-8xl font-semibold text-gold-500/40">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold">This blueprint never got built.</h1>
    <p class="mt-3 max-w-md text-paper-400">
      The page you're looking for doesn't exist — or hasn't been architected yet.
    </p>
    <a href={base} class="btn-primary mt-8">Back to home</a>
  </div>
</Layout>
