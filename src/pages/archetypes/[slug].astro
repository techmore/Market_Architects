---
import Layout from "../../layouts/Layout.astro";
import FounderCard from "../../components/FounderCard.astro";
import BookCard from "../../components/BookCard.astro";
import LectureCard from "../../components/LectureCard.astro";
import { archetypes, getArchetype } from "../../data/archetypes";
import { getModel } from "../../data/models";
import { getFounder } from "../../data/founders";
import { getBook } from "../../data/books";
import { getLecture } from "../../data/lectures";

export async function getStaticPaths() {
  return archetypes.map((a) => ({ params: { slug: a.slug }, props: { archetype: a } }));
}

const { archetype } = Astro.props;
const base = import.meta.env.BASE_URL;
const model = getModel(archetype.model);
const archetypeFounders = archetype.founders.map(getFounder);
const archetypeBooks = archetype.books.map(getBook);
const lecture = archetype.lecture ? getLecture(archetype.lecture) : null;
const related = archetypes.filter((a) => a.slug !== archetype.slug);
---

<Layout title={archetype.name} description={archetype.philosophy}>
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-14 md:py-16">
      <a href={`${base}archetypes/`} class="text-xs font-medium uppercase tracking-wider text-paper-500 hover:text-gold-300">
        ← All archetypes
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-gold-500/50 px-3 py-1 text-xs font-medium text-gold-300">
          Model {model.index} · {model.title}
        </span>
      </div>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        {archetype.name}
      </h1>
      <p class="mt-3 text-base font-medium text-gold-300">{archetype.tagline}</p>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-paper-200">{archetype.philosophy}</p>
    </div>
  </div>

  <div class="container-site py-14">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="eyebrow">The operating creed</p>
        <p class="mt-2 text-sm text-paper-400">
          How this philosophy answers the five questions every owner must settle.
        </p>
        <div class="mt-5 space-y-3">
          {archetype.values.map((v) => (
            <div class="card flex items-start gap-4 p-5">
              <span class="shrink-0 rounded-lg border border-gold-500/40 px-3 py-1.5 text-xs font-semibold text-gold-300">
                {v.dimension}
              </span>
              <p class="text-sm leading-relaxed text-paper-200">{v.belief}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 rounded-xl border-l-4 border-green-500 bg-ink-850 p-6">
          <p class="eyebrow">Where it thrives</p>
          <p class="mt-3 text-base leading-relaxed text-paper-200">{archetype.marketFit}</p>
        </div>

        {lecture && (
          <>
            <p class="mt-10 eyebrow">Start here</p>
            <div class="mt-4 grid gap-5 sm:grid-cols-2">
              <LectureCard lecture={lecture} />
            </div>
          </>
        )}

        <p class="mt-10 eyebrow">Reading list</p>
        <div class="mt-4 grid gap-5">
          {archetypeBooks.map((b) => <BookCard book={b} />)}
        </div>
      </div>

      <aside class="space-y-6">
        <div class="card p-5">
          <p class="eyebrow">Leaders who lived it</p>
          <div class="mt-4 space-y-3">
            {archetypeFounders.map((f) => <FounderCard founder={f} />)}
          </div>
        </div>

        <a href={`${base}models/${model.slug}/`} class="card card-hover flex items-center justify-between p-5">
          <div>
            <p class="font-display text-lg font-semibold">{model.title}</p>
            <p class="text-xs text-paper-400">{model.tagline}</p>
          </div>
          <span class="text-gold-400">→</span>
        </a>

        <div class="card p-5">
          <p class="eyebrow">Other archetypes</p>
          <div class="mt-4 space-y-3">
            {related.map((a) => (
              <a href={`${base}archetypes/${a.slug}/`} class="block rounded-lg border border-ink-700 bg-ink-900 p-4 transition hover:border-gold-500/60">
                <p class="text-sm font-semibold text-paper-100">{a.name}</p>
                <p class="mt-1 text-xs text-paper-400">{a.tagline}</p>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
