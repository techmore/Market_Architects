---
import Layout from "../layouts/Layout.astro";
import { lectures } from "../data/lectures";
import { books } from "../data/books";
import { founders } from "../data/founders";
import { models } from "../data/models";
import { playbooks } from "../data/playbooks";
import { allTags } from "../data/tags";

const base = import.meta.env.BASE_URL;
const entries = [
  ...lectures.map((x) => ({ type: "Lecture", title: x.title, text: `${x.founder} ${x.keywords.join(" ")}`, href: `${base}lectures/${x.slug}/` })),
  ...books.map((x) => ({ type: "Book", title: x.title, text: `${x.author} ${x.review}`, href: `${base}books/${x.slug}/` })),
  ...founders.map((x) => ({ type: "Leader", title: x.name, text: `${x.company} ${x.bio} ${x.knownFor.join(" ")}`, href: `${base}founders/${x.slug}/` })),
  ...models.map((x) => ({ type: "Model", title: x.title, text: `${x.tagline} ${x.philosophy}`, href: `${base}models/${x.slug}/` })),
  ...playbooks.map((x) => ({ type: "Playbook", title: x.title, text: `${x.problem} ${x.summary}`, href: `${base}playbooks/${x.slug}/` })),
  ...allTags().map((x) => ({ type: "Idea", title: x.keyword, text: `${x.keyword} ${x.items.map((l) => l.title).join(" ")}`, href: `${base}tags/${x.slug}/` })),
];
---

<Layout title="Search" description="Search Market Architects lectures, books, leaders, models, playbooks, and ideas.">
  <section class="container-site py-14 md:py-16">
    <p class="eyebrow">Find your next idea</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight md:text-5xl">Search the library</h1>
    <label for="site-search" class="sr-only">Search the library</label>
    <input id="site-search" type="search" autofocus placeholder="Try “cash flow”, “Jobs”, or “flywheel”" class="mt-8 w-full rounded-lg border border-ink-600 bg-ink-900 px-4 py-3 text-paper-50 placeholder:text-paper-500 focus:border-gold-500 focus:outline-none" />
    <p id="search-count" class="mt-4 text-sm text-paper-400"></p>
    <div id="search-results" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="search-empty" class="mt-10 hidden text-center text-sm text-paper-500">No results. Try a broader idea or a founder’s name.</p>
  </section>
</Layout>

<script define:vars={{ entries }}>
  const input = document.getElementById("site-search");
  const results = document.getElementById("search-results");
  const empty = document.getElementById("search-empty");
  const count = document.getElementById("search-count");
  function render() {
    const query = (input?.value ?? "").trim().toLowerCase();
    const matches = entries.filter((entry) => !query || `${entry.title} ${entry.text}`.toLowerCase().includes(query)).slice(0, 60);
    if (count) count.textContent = `${matches.length} result${matches.length === 1 ? "" : "s"}`;
    if (empty) empty.classList.toggle("hidden", matches.length > 0);
    if (results) {
      results.replaceChildren(...matches.map((entry) => {
        const link = document.createElement("a");
        link.href = entry.href;
        link.className = "card card-hover block p-5";
        const type = document.createElement("p");
        type.className = "eyebrow";
        type.textContent = entry.type;
        const title = document.createElement("h2");
        title.className = "mt-2 font-display text-lg font-semibold";
        title.textContent = entry.title;
        const explore = document.createElement("span");
        explore.className = "mt-4 inline-block text-sm text-gold-400";
        explore.textContent = "Explore →";
        link.append(type, title, explore);
        return link;
      }));
    }
  }
  input?.addEventListener("input", render);
  render();
</script>
