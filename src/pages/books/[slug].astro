---
import Layout from "../../layouts/Layout.astro";
import { books, getBook } from "../../data/books";
import { getModel } from "../../data/models";
import { lecturesByModel } from "../../data/lectures";
import { getFounder } from "../../data/founders";
import LectureCard from "../../components/LectureCard.astro";

export async function getStaticPaths() {
  return books.map((b) => ({ params: { slug: b.slug }, props: { book: b } }));
}

const { book } = Astro.props;
const base = import.meta.env.BASE_URL;
const model = getModel(book.model);
const pairedLectures = lecturesByModel(book.model).slice(0, 3);

const coverBg: Record<string, string> = {
  gold: "from-gold-600 via-gold-500 to-gold-400 text-ink-950",
  clay: "from-clay-600 via-clay-500 to-clay-400 text-paper-50",
  ink: "from-ink-800 via-ink-700 to-ink-600 text-paper-100",
  green: "from-[#2f4a38] via-green-500 to-[#7fb08c] text-paper-50",
  blue: "from-[#22324a] via-[#3a5a80] to-[#6f93bb] text-paper-50",
};
const bg = coverBg[book.cover] ?? coverBg.ink;

function stars(rating: number) {
  const full = Math.floor(rating);
  const half = rating - full >= 0.5;
  let out = "";
  for (let i = 0; i < full; i++) out += "★";
  if (half) out += "½";
  return out;
}
---

<Layout title={book.title} description={book.review}>
  <div class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-14 md:py-16">
      <a href={`${base}books/`} class="text-xs font-medium uppercase tracking-wider text-paper-500 hover:text-gold-300">
        ← All books
      </a>
      <div class="mt-6 flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
        <div class="flex gap-6">
          <div class={`flex w-28 shrink-0 flex-col justify-between rounded-lg bg-gradient-to-br p-4 shadow-lg ${bg}`}>
            <span class="text-[10px] font-bold uppercase tracking-widest opacity-80">Architect</span>
            <div>
              <p class="font-display text-base font-bold leading-tight">{book.title}</p>
              <p class="mt-1 text-[11px] opacity-80">{book.author}</p>
              <p class="mt-1 text-[11px] opacity-70">{book.year}</p>
            </div>
          </div>
          <div>
            <h1 class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{book.title}</h1>
            <p class="mt-2 text-base text-paper-300">{book.author}</p>
            <p class="mt-2 text-lg text-gold-400">{stars(book.rating)} <span class="text-sm text-paper-500">/ 5</span></p>
            <a href={`${base}models/${model.slug}/`} class="mt-3 inline-block rounded-full border border-gold-500/50 px-3 py-1 text-xs font-medium text-gold-300 hover:bg-gold-500/10">
              {model.title}
            </a>
          </div>
        </div>
      </div>
      <p class="mt-6 max-w-3xl font-display text-xl italic leading-relaxed text-paper-100">{book.blurb}</p>
    </div>
  </div>

  <div class="container-site py-12">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="prose prose-invert prose-paper max-w-none">
          <p class="text-base leading-relaxed text-paper-200">{book.review}</p>
        </div>

        <div class="mt-10 rounded-xl border border-ink-700 bg-ink-850 p-6">
          <p class="eyebrow">Takeaways you can act on</p>
          <ul class="mt-4 space-y-3">
            {book.takeaways.map((t) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-paper-200">
                <span class="mt-0.5 text-gold-400">▸</span>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 rounded-xl border-l-4 border-green-500 bg-ink-850 p-6">
          <p class="eyebrow">Why it matters for a small business</p>
          <p class="mt-3 text-base leading-relaxed text-paper-200">{book.whyItMatters}</p>
        </div>
      </div>

      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="card p-5">
          <p class="eyebrow">Pair with lectures</p>
          <div class="mt-4 space-y-4">
            {pairedLectures.map((l) => <LectureCard lecture={l} />)}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
