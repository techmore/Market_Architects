---
import Layout from "../layouts/Layout.astro";
import ModelCard from "../components/ModelCard.astro";
import LectureCard from "../components/LectureCard.astro";
import BookCard from "../components/BookCard.astro";
import Newsletter from "../components/Newsletter.astro";
import { models } from "../data/models";
import { lectures, featuredLectures } from "../data/lectures";
import { books } from "../data/books";
import { pathways } from "../data/pathways";

const featured = featuredLectures();
const base = import.meta.env.BASE_URL;
---

<Layout title="Mental Models for Small Business Owners" description="Annotated lectures, transcripts, and book reviews — the mental models of legendary founders, translated into actions for small business owners.">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-ink-800">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(196,148,70,0.12),transparent_55%),radial-gradient(ellipse_at_bottom_left,rgba(95,138,106,0.08),transparent_55%)]"></div>
    <div class="container-site relative py-20 md:py-28">
      <p class="eyebrow">The founder mental-model library</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-[1.1] tracking-tight md:text-6xl">
        Great founders think in <span class="text-gold-400">systems</span>, not hustle.
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-paper-300 md:text-lg">
        Market Architects distills 63 of the world's most useful business thinkers — founders,
        authors, and professors — into 10 mental models, with annotated 3-minute video clips,
        "Apply This Model" translations, and book reviews that matter.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}skill-tree/`} class="btn-primary">
          Start the free course
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={`${base}models/`} class="btn-ghost">Browse 10 models</a>
      </div>

      <!-- Model filter chips -->
      <div class="mt-12 flex flex-wrap gap-2" role="group" aria-label="Filter lectures by mental model">
        <button data-filter="all" class="filter-chip rounded-full border border-gold-500 bg-gold-500 px-4 py-1.5 text-sm font-semibold text-ink-950">
          All
        </button>
        {models.map((m) => (
          <button data-filter={m.slug} class="filter-chip rounded-full border border-ink-600 px-4 py-1.5 text-sm font-medium text-paper-200 transition hover:border-gold-500/60 hover:text-gold-300">
            {m.title}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Start here: two doors -->
  <section class="border-b border-ink-800 bg-ink-900">
    <div class="container-site py-16 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Start here</p>
          <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">Which door are you standing in front of?</h2>
        </div>
        <a href={`${base}pathways/`} class="text-sm font-medium text-gold-400 hover:text-gold-300">All pathways →</a>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <a
          href={`${base}pathways/ideas-explorer/`}
          class="group relative overflow-hidden rounded-2xl border border-ink-700 bg-gradient-to-br from-gold-600 to-gold-400 p-8 transition hover:border-gold-500"
        >
          <p class="text-xs font-bold uppercase tracking-widest text-ink-950/70">Door 01</p>
          <h3 class="mt-2 font-display text-3xl font-bold leading-tight text-ink-950">I'm looking for new ideas</h3>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-950/80">
            Walk The Idea Explorer — a guided tour through all 10 mental models, one framework per
            stop, from competition to purpose.
          </p>
          <span class="mt-6 inline-flex items-center gap-2 rounded-lg bg-ink-950/85 px-4 py-2 text-sm font-semibold text-paper-50 transition group-hover:bg-ink-950">
            Start exploring →
          </span>
        </a>

        <a
          href={`${base}pathways/founder-journey/`}
          class="group relative overflow-hidden rounded-2xl border border-ink-700 bg-gradient-to-br from-[#2f4a38] to-[#4c7358] p-8 transition hover:border-green-500"
        >
          <p class="text-xs font-bold uppercase tracking-widest text-paper-50/70">Door 02</p>
          <h3 class="mt-2 font-display text-3xl font-bold leading-tight text-paper-50">I want to hear from great founders</h3>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-paper-50/85">
            Walk The Founder's Journey — the arc every great company takes, told by the founders who
            lived it, from conviction to flywheel.
          </p>
          <span class="mt-6 inline-flex items-center gap-2 rounded-lg bg-paper-50 px-4 py-2 text-sm font-semibold text-ink-950 transition group-hover:bg-paper-100">
            Start the journey →
          </span>
        </a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {pathways.map((p) => (
          <a href={`${base}pathways/${p.slug}/`} class="card card-hover flex flex-col p-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-gold-400">
                {p.entry === "ideas" ? "New ideas" : "Great founders"}
              </span>
              <span class="text-[11px] text-paper-500">{p.steps.length} stops</span>
            </div>
            <p class="mt-3 font-display text-lg font-semibold leading-snug">{p.title}</p>
            <span class="mt-auto pt-4 text-sm font-medium text-gold-400 transition group-hover:translate-x-0.5">Walk →</span>
          </a>
        ))}
      </div>

      <!-- Continue your path (revealed by JS when progress exists) -->
      <div id="continue-path" class="mt-6 hidden">
        <div class="flex flex-col items-start justify-between gap-4 rounded-xl border border-gold-500/50 bg-ink-850 p-6 md:flex-row md:items-center">
          <div>
            <p class="eyebrow text-gold-400">Continue your path</p>
            <p class="mt-1 font-display text-lg font-semibold">Pick up where you left off.</p>
            <p id="continue-meta" class="text-xs text-paper-400"></p>
            <p id="continue-tree-meta" class="mt-1 text-xs text-paper-400"></p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a id="continue-link" href={base} class="btn-primary shrink-0">Resume →</a>
            <a id="continue-tree-link" href={`${base}skill-tree/`} class="btn-ghost hidden shrink-0">Continue the course →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skill tree promo -->
  <section class="border-b border-ink-800 bg-gradient-to-r from-ink-900 via-ink-850 to-ink-900">
    <div class="container-site flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center">
      <div class="max-w-2xl">
        <p class="eyebrow">The poor man's MBA</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">Take the full course — 60 lessons in 6 tiers</h2>
        <p class="mt-3 text-sm leading-relaxed text-paper-300">
          Think first → create → spread it → operate it perfectly → lead the team → survive the shift.
          A guided progression from the people who actually did it, with nothing to pay and no exams.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={`${base}skill-tree/`} class="btn-primary">
          Open the skill tree
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={`${base}pathways/`} class="btn-ghost">Prefer the guided paths?</a>
      </div>
    </div>
  </section>

  <!-- Featured lectures with search -->
  <section id="featured" class="container-site py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Featured lectures</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">The core arguments, isolated</h2>
      </div>
      <div class="w-full max-w-sm">
        <label class="sr-only" for="search">Search lectures</label>
        <div class="relative">
          <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-paper-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input
            id="search"
            type="search"
            placeholder="Search monopolies, flywheels, cash-flow…"
            class="w-full rounded-lg border border-ink-600 bg-ink-900 py-2.5 pl-10 pr-3 text-sm text-paper-50 placeholder:text-paper-500 focus:border-gold-500 focus:outline-none"
          />
        </div>
      </div>
    </div>

    <div id="lecture-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {lectures.map((lecture) => (
        <div
          class:list={["lecture-item", lecture.featured ? "" : "lecture-more hidden"]}
          data-model={lecture.model}
          data-title={lecture.title.toLowerCase()}
        >
          <LectureCard lecture={lecture} />
        </div>
      ))}
    </div>
    <p id="no-results" class="mt-10 hidden text-center text-sm text-paper-500">
      No lectures match that search. Try "competition", "design", or "cash".
    </p>
    <div class="mt-8 flex justify-center">
      <button id="show-all" class="btn-ghost">
        Show all {lectures.length} lectures
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>
  </section>

  <!-- Models -->
  <section class="border-t border-ink-800 bg-ink-900">
    <div class="container-site py-16 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">The taxonomy</p>
          <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">10 core mental models</h2>
        </div>
        <a href={`${base}models/`} class="text-sm font-medium text-gold-400 hover:text-gold-300">All models →</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {models.map((m) => <ModelCard model={m} />)}
      </div>
    </div>
  </section>

  <!-- Books -->
  <section class="container-site py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Book reviews that matter</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">Read the source material</h2>
      </div>
      <a href={`${base}books/`} class="text-sm font-medium text-gold-400 hover:text-gold-300">All books →</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {books.slice(0, 4).map((b) => <BookCard book={b} />)}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="container-site pb-16 md:pb-20">
    <Newsletter />
  </section>
</Layout>

<script>
  const BASE = document.body?.dataset.base ?? "/Market_Architects/";
  const grid = document.getElementById("lecture-grid");
  const search = document.getElementById("search");
  const noResults = document.getElementById("no-results");
  const showAll = document.getElementById("show-all");
  const chips = Array.from(document.querySelectorAll(".filter-chip"));

  let activeModel = "all";
  let expanded = false;

  function applyFilter() {
    const q = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll(".lecture-item").forEach((el) => {
      const matchesModel = activeModel === "all" || el.dataset.model === activeModel;
      const matchesQuery = !q || (el.dataset.title ?? "").includes(q);
      const isHidden = !expanded && el.classList.contains("lecture-more");
      const show = matchesModel && matchesQuery && !isHidden;
      el.style.display = show ? "" : "none";
      if (show) visible++;
    });
    if (noResults) noResults.classList.toggle("hidden", visible > 0);
    if (showAll) {
      const anyMore = !!document.querySelector(".lecture-item.lecture-more");
      showAll.classList.toggle("hidden", !anyMore);
      if (expanded) showAll.textContent = "Show fewer";
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activeModel = chip.dataset.filter ?? "all";
      chips.forEach((c) => {
        if (c === chip) {
          c.classList.remove("border-ink-600", "text-paper-200");
          c.classList.add("border-gold-500", "bg-gold-500", "text-ink-950");
        } else {
          c.classList.add("border-ink-600", "text-paper-200");
          c.classList.remove("border-gold-500", "bg-gold-500", "text-ink-950");
        }
      });
      applyFilter();
    });
  });

  showAll?.addEventListener("click", () => {
    expanded = !expanded;
    applyFilter();
  });

  search?.addEventListener("input", applyFilter);
  applyFilter();

  // Continue-your-path: reveal if the visitor has saved progress on any pathway
  const continueBox = document.getElementById("continue-path");
  const continueLink = document.getElementById("continue-link");
  const continueMeta = document.getElementById("continue-meta");
  const continueTreeLink = document.getElementById("continue-tree-link");
  const continueTreeMeta = document.getElementById("continue-tree-meta");
  const PATH_PREFIX = "ma-progress-";
  try {
    let sawProgress = false;
    const entries = Object.keys(localStorage)
      .filter((k) => k.startsWith(PATH_PREFIX) && k !== "ma-progress-tree")
      .map((k) => ({ key: k, val: JSON.parse(localStorage.getItem(k) || "[]") }))
      .filter((e) => Array.isArray(e.val) && e.val.length > 0);
    if (entries.length > 0 && continueBox && continueLink && continueMeta) {
      const mostRecent = entries.sort((a, b) => (b.val.at(-1) || 0) - (a.val.at(-1) || 0))[0];
      const slug = mostRecent.key.slice(PATH_PREFIX.length);
      const label = slug.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());
      const done = mostRecent.val.filter((n: number) => n !== null && n !== undefined).length;
      continueBox.classList.remove("hidden");
      continueLink.href = `${BASE}pathways/${slug}/`;
      continueMeta.textContent = `${label} — ${done} stop${done === 1 ? "" : "s"} complete`;
      sawProgress = true;
    }
    // course progress
    const treeVal = JSON.parse(localStorage.getItem("ma-progress-tree") || "[]");
    if (Array.isArray(treeVal) && treeVal.length > 0 && continueBox && continueTreeLink && continueTreeMeta) {
      continueBox.classList.remove("hidden");
      continueTreeLink.classList.remove("hidden");
      continueTreeMeta.textContent = `Course — ${treeVal.length} of 54 lessons complete`;
      sawProgress = true;
    }
    if (!sawProgress && continueBox) continueBox.classList.add("hidden");
  } catch (e) {
    // localStorage unavailable (private mode etc.) — silently skip
  }
</script>
