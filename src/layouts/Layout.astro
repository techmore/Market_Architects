---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Market Architects — the mental models of legendary founders, translated for small business owners.", image } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = "https://techmore.github.io" + base;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image ? image : `${siteUrl}favicon.svg`;
const pathParts = Astro.url.pathname.replace(base, "").split("/").filter(Boolean);
const breadcrumbLabel = (part: string) => part.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0c10" />
    <title>{title} · Market Architects</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Market Architects" />
    <meta property="og:title" content={`${title} · Market Architects`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={siteUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Market Architects`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Market Architects",
      url: siteUrl,
      description,
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col" data-base={base}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      {pathParts.length > 0 && (
        <nav aria-label="Breadcrumb" class="container-site pt-5 text-xs text-paper-500">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={base} class="hover:text-gold-300">Home</a></li>
            {pathParts.map((part, index) => {
              const href = `${base}${pathParts.slice(0, index + 1).join("/")}/`;
              const current = index === pathParts.length - 1;
              return (
                <li class="flex items-center gap-2">
                  <span aria-hidden="true">/</span>
                  {current ? <span class="text-paper-300" aria-current="page">{breadcrumbLabel(part)}</span> : <a href={href} class="hover:text-gold-300">{breadcrumbLabel(part)}</a>}
                </li>
              );
            })}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
